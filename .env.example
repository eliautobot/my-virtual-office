# Virtual Office Configuration
# Copy this file to .env and adjust values for your setup.

# Path to your OpenClaw installation (Skills library, and the gateway token the
# first start reads from openclaw.json)
VO_OPENCLAW_PATH=~/.openclaw

# OpenClaw gateway connection
# Default uses host.docker.internal which works on Linux, Windows, and macOS.
# Override only if your gateway runs on a different host/port. Since v0.11 this fills
# in the first OpenClaw connection once; after that, edit it in Agent Providers.
# From this bridge network the office pairs as a device: approve it once with the
# `openclaw devices approve <id>` command Agent Providers > OpenClaw shows. With
# `network_mode: host` (Linux) use ws://127.0.0.1:18789 instead: no pairing.
VO_GATEWAY_URL=ws://host.docker.internal:18789
VO_GATEWAY_HTTP=http://host.docker.internal:18789

# OpenClaw and Hermes run on the integration copied from My Virtual World (v0.11,
# Node.js is in the image). 0 keeps 0.10's Python path for this release (legacy).
VO_PROVIDER_LAYER=1

# Server ports. 8091 is the old raw gateway tunnel: nothing listens there unless
# VO_OPENCLAW_BROWSER_TRANSPORT=direct is set.
VO_PORT=8090
VO_WS_PORT=8091

# Office display name
VO_OFFICE_NAME=Virtual Office

# Access and security
# Other devices on your network can open the office. Turn on a passcode in
# Settings > Security (or in the setup wizard). This computer never needs it.
# Pages from other websites can never change the office.
# Extra host names the office answers to, for example a reverse proxy domain:
# VO_ALLOWED_HOSTS=office.example.com
# Fixed token for agents that call the office API from another machine
# (send "Authorization: Bearer <token>"). Leave empty to use the generated one
# shown in Settings > Security.
# VO_AGENT_API_TOKEN=
# Linux with Docker's bridge network: agents on this machine reach the office
# through the bridge gateway. List that address so they skip the passcode too
# (check with: docker network inspect bridge). Never set this on Docker Desktop.
# VO_TRUSTED_CLIENT_IPS=172.17.0.1
# Run the container as your own user (uncomment `user:` in docker-compose.yml;
# the data volume must belong to that user, see the note there and docs/UPDATING.md):
# PUID=1000
# PGID=1000

# Codex CLI agents
# Docker containers usually cannot run Codex's bubblewrap sandbox unless they
# are started with extra privileges, so the Docker default is full container access.
VO_CODEX_SANDBOX=danger-full-access
# The starting Permissions mode of a Codex agent nobody has set yet: untrusted = Ask first
# (it asks in the chat before running commands or changing files), never = Full access.
# What you pick in an agent's chat window (Permissions) is saved and always wins over this.
VO_CODEX_APPROVAL_POLICY=untrusted

# Hermes: connect `hermes serve` (every profile, the full window) in Agent Providers.
# The settings below are for the older Hermes API server connections (one profile
# per API server), which keep working in the office's own chat window.
# Configure these more easily in Settings, or provide a JSON list here.
VO_HERMES_ENABLED=true
VO_HERMES_CONNECTIONS_JSON=[]
# Example:
# VO_HERMES_CONNECTIONS_JSON=[{"id":"astra","name":"Astra","apiUrl":"http://host.docker.internal:8642","apiKey":"replace-me"}]

# Hermes API transport and mounted resources are deliberately independent.
# The mount contains SOUL/profile/workspace/skill sources; Virtual Office does
# not need a second Hermes CLI and never receives the Docker socket.
VO_HERMES_HOST_DATA=~/.hermes
VO_HERMES_RESOURCE_ROOT=/data/hermes
# read-write, read-only, or disabled. Docker-enforced RO also wins.
VO_HERMES_RESOURCE_ACCESS=read-write
VO_HERMES_RESOURCE_VOLUME_MODE=rw
VO_HERMES_CONTEXT_MAX_MESSAGES=120
VO_HERMES_CONTEXT_MAX_CHARS=120000
VO_HERMES_CONTEXT_MAX_MESSAGE_CHARS=32000

# Optional pinned, separate Hermes sidecar:
#   VO_HERMES_CONNECTIONS_JSON=[{"id":"default","name":"Hermes","apiUrl":"http://hermes:8642","apiKey":"replace-with-strong-key"}]
#   docker compose --profile hermes up -d
VO_HERMES_IMAGE=nousresearch/hermes-agent:v2026.8.3
VO_HERMES_API_KEY=
# Use `id -u` / `id -g` for bind-mount ownership on Linux.
VO_HERMES_UID=10000
VO_HERMES_GID=10000

# Optional Hermes Messaging Gateway platform mode. This is separate from
# native API connections: Hermes gateway polls Virtual Office and
# posts replies back as a messaging platform.
# VO_HERMES_PLATFORM_ENABLED=true
# VO_HERMES_PLATFORM_TOKEN=replace-with-a-long-random-token
# VO_HERMES_PLATFORM_AGENT_ID=hermes-gateway

# Weather widget location (optional, e.g. "New+York,NY")
VO_WEATHER_LOCATION=

# Agent PC / Agent Files
# Deduplicated Recent entries retained per agent (10-1000).
VO_AGENT_PC_RECENT_LIMIT=100
# Approved local/container mappings and optional remote Agent Files Connectors.
# Windows Docker Desktop example (also add the matching bind mount in a Compose override):
# VO_AGENT_PC_PATH_MAPPINGS_JSON=[{"id":"windows-projects","label":"Windows Projects","hostPath":"C:\\Users\\you\\Projects","containerPath":"/agent-mounts/windows-projects","readOnly":true}]
# Remote connector example:
# VO_AGENT_PC_PATH_MAPPINGS_JSON=[{"id":"remote-windows","label":"Remote Windows PC","hostPath":"D:\\Projects","connectorUrl":"https://windows-pc.example:8765","connectorToken":"replace-me","connectorRootId":"projects"}]
VO_AGENT_PC_PATH_MAPPINGS_JSON=[]
# HTTP connectors are accepted only on loopback by default. Enable this only
# when transport security is supplied by a trusted private overlay network.
VO_AGENT_PC_ALLOW_INSECURE_CONNECTORS=false

# Agent Browser VNC password (if using the optional browser service)
# BROWSER_VNC_PASSWORD=changeme
