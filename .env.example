# Virtual Office Configuration
# Copy this file to .env and adjust values for your setup.

# Path to your OpenClaw installation
VO_OPENCLAW_PATH=~/.openclaw

# OpenClaw gateway connection
# Default uses host.docker.internal which works on Linux, Windows, and macOS.
# Override only if your gateway runs on a different host/port.
VO_GATEWAY_URL=ws://host.docker.internal:18789
VO_GATEWAY_HTTP=http://host.docker.internal:18789

# Server ports
VO_PORT=8090
VO_WS_PORT=8091

# Office display name
VO_OFFICE_NAME=Virtual Office

# Codex CLI agents
# Docker containers usually cannot run Codex's bubblewrap sandbox unless they
# are started with extra privileges, so the Docker default is full container access.
VO_CODEX_SANDBOX=danger-full-access
VO_CODEX_APPROVAL_POLICY=never

# Hermes API Server + optional Desktop Backend + optional CLI fallback
# In Docker, the Virtual Office container reaches the host Hermes API Server here.
# Hermes must have API_SERVER_ENABLED=true and API_SERVER_KEY set.
VO_HERMES_API_URL=http://host.docker.internal:8642
VO_HERMES_API_KEY=
# Optional Desktop Backend mode. For the already-open Desktop app, use the
# loopback URL Hermes Desktop is bound to. Docker routes loopback URLs through
# host.docker.internal while preserving Hermes' expected Host identity.
# VO_HERMES_DESKTOP_URL=http://127.0.0.1:62353
# VO_HERMES_DESKTOP_TCP_HOST=host.docker.internal
# VO_HERMES_DESKTOP_TCP_PORT=62353
# VO_HERMES_DESKTOP_HOST_HEADER=127.0.0.1:62353
# VO_HERMES_DESKTOP_LOG_PATH=/path/to/mounted/hermes/logs/desktop.log
# Optional only when Hermes CLI/home are installed or mounted inside the container.
# VO_HERMES_HOME=/root/.hermes
# VO_HERMES_BIN=/root/.local/bin/hermes

# Optional Hermes Messaging Gateway platform mode. This is separate from
# Desktop Backend/API Server mode: Hermes gateway polls Virtual Office and
# posts replies back as a messaging platform.
# VO_HERMES_PLATFORM_ENABLED=true
# VO_HERMES_PLATFORM_TOKEN=replace-with-a-long-random-token
# VO_HERMES_PLATFORM_AGENT_ID=hermes-gateway

# Weather widget location (optional, e.g. "New+York,NY")
VO_WEATHER_LOCATION=

# Agent Browser VNC password (if using the optional browser service)
# BROWSER_VNC_PASSWORD=changeme

# OpenCode CLI agents. Chat uses `opencode run --format json`; file uploads
# are passed with `--file`, and approvals rerun once with `--auto`.
VO_OPENCODE_ENABLED=0
VO_OPENCODE_CONFIG_DIR=~/.config/opencode
VO_OPENCODE_BIN=
VO_OPENCODE_WORKSPACE_ROOT=
VO_OPENCODE_MAIN_WORKSPACE=
VO_OPENCODE_MODEL=
VO_OPENCODE_TIMEOUT_SEC=900
VO_OPENCODE_INCLUDE_MAIN=1
VO_OPENCODE_INCLUDE_AGENTS=1
VO_OPENCODE_REGISTER_AGENTS=1
VO_OPENCODE_ENV_ALLOWLIST=

# Antigravity (agy) CLI agent. Uses stateless `agy --print`; Virtual Office
# stores local chat history but does not claim native agy sessions.
VO_ANTIGRAVITY_ENABLED=0
VO_ANTIGRAVITY_HOME=~/.gemini/antigravity-cli
VO_ANTIGRAVITY_BIN=
VO_ANTIGRAVITY_WORKSPACE_ROOT=
VO_ANTIGRAVITY_TIMEOUT_SEC=600
VO_ANTIGRAVITY_PRINT_TIMEOUT=5m
VO_ANTIGRAVITY_MODEL=
VO_ANTIGRAVITY_SANDBOX=
VO_ANTIGRAVITY_ENV_ALLOWLIST=
