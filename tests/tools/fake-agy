#!/usr/bin/env python3
"""Fake Antigravity CLI (agy) for office tests (never a real account, never a model).

Emulates what app/providers/antigravity.py runs and parses:
  agy --print <prompt> [--agent A] [--conversation C] [--model M] [--sandbox S] [--print-timeout T]
      the answer on stdout at the end (no stream, no thinking, no steps: the CLI's print mode); a new conversation names
      itself on stderr ("conversation id: <id>", what _conversation_id reads); an unknown --conversation fails.
  agy models        the model list (the office's sign-in probe: exit 0 = signed in; FAKE_AGY_SIGNED_OUT=1 -> "sign in")
  agy agent         "<name> (primary)" lines (FAKE_AGY_AGENTS, default "gravity"; plus the built-in build/plan)
  agy --version
Scripted by directives in the message, see fake_cli_lib.py ([[slow]], [[error]]; [[tool]] is ignored). Stop = SIGKILL of
the group (the office's _kill_group). State: $HOME/.vo-fakes/agy.
"""
from __future__ import annotations

import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import fake_cli_lib as L  # noqa: E402

LABEL = "Fake Antigravity"
STATE = L.State(os.path.join(os.path.expanduser("~"), ".vo-fakes", "agy"))


def main(argv: list[str]) -> int:
    STATE.log_call(argv)
    if not argv or argv[0] in ("--version", "-v"):
        print("agy 0.0.0-fake")
        return 0
    if argv[0] == "models":
        if os.environ.get("FAKE_AGY_SIGNED_OUT") == "1":
            print("Please sign in to Antigravity first.", file=sys.stderr)
            return 1
        print("fake-gemini-1\nfake-gemini-1-lite")
        return 0
    if argv[0] == "agent":
        names = [n.strip() for n in (os.environ.get("FAKE_AGY_AGENTS") or "gravity").split(",") if n.strip()]
        print("\n".join(["build (primary)", "plan (primary)", *[f"{n} (primary)" for n in names], "general (subagent)"]))
        return 0
    if "--print" in argv or "-p" in argv:
        opts, pos = {}, []
        i = 0
        while i < len(argv):
            a = argv[i]
            if a in ("--print", "-p") and i + 1 < len(argv):
                pos.append(argv[i + 1])
                i += 2
                continue
            if a in ("--agent", "--conversation", "--model", "--sandbox", "--print-timeout") and i + 1 < len(argv):
                opts[a] = argv[i + 1]
                i += 2
                continue
            i += 1
        prompt = pos[0] if pos else ""
        cid = opts.get("--conversation") or ""
        if cid:
            conv = STATE.load(f"conversations/{cid}.json", None)
            if conv is None:
                print(f"Error: conversation {cid} not found", file=sys.stderr)
                return 1
        else:
            cid = STATE.next_id("conv-fake-", 6)
            conv = {"id": cid, "agent": opts.get("--agent") or "", "turns": []}
            print(f"conversation id: {cid}", file=sys.stderr)
        n = len(conv["turns"]) + 1
        d = L.directives(prompt)
        if "error" in d:
            print("fake failure", file=sys.stderr)
            return 1
        if "slow" in d:
            count, step = L.slow_plan()
            time.sleep(count * step)
            reply = L.slow_text(LABEL, n, prompt)
        else:
            time.sleep(L.step_delay() * 3)
            reply = L.answer(LABEL, n, prompt)
        conv["turns"].append({"user": prompt, "reply": reply})
        STATE.save(f"conversations/{cid}.json", conv)
        print(reply)
        return 0
    print(f"fake-agy: unsupported command {' '.join(argv)[:200]}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
